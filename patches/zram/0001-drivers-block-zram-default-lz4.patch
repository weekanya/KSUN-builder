From a1b2c3d4e5f678901234567890abcdef12345678 Mon Sep 17 00:00:00 2001
From: weekanya <wee@users.noreply.github.com>
Date: Thu, 10 Sep 2026 15:45:00 +0300
Subject: [PATCH] drivers: block: zram: change default compressor to lz4

Set default zram compressor to lz4 in Kconfig and initialize
default_compressor to "lz4" in zram_drv.c for faster decompression
speeds and reduced CPU utilization.

Signed-off-by: weekanya <wee@users.noreply.github.com>
---
 drivers/block/zram/Kconfig    | 2 +-
 drivers/block/zram/zram_drv.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/block/zram/Kconfig b/drivers/block/zram/Kconfig
index 1234567..89abcdef 100644
--- a/drivers/block/zram/Kconfig
+++ b/drivers/block/zram/Kconfig
@@ -16,7 +16,7 @@ config ZRAM
 
 choice
 	prompt "Default zram compressor"
-	default ZRAM_DEF_COMP_LZORLE
+	default ZRAM_DEF_COMP_LZ4
 	depends on ZRAM
 
 config ZRAM_DEF_COMP_LZORLE
diff --git a/drivers/block/zram/zram_drv.c b/drivers/block/zram/zram_drv.c
index 1234567..89abcdef 100644
--- a/drivers/block/zram/zram_drv.c
+++ b/drivers/block/zram/zram_drv.c
@@ -48,7 +48,7 @@ static DEFINE_IDR(zram_index_idr);
 static DEFINE_MUTEX(zram_index_mutex);
 
 static int zram_major;
-static const char *default_compressor = CONFIG_ZRAM_DEF_COMP;
+static const char *default_compressor = "lz4";
 
 /* Module params (documentation at end) */
 static unsigned int num_devices = 1;
-- 
